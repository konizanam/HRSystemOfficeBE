# Database. The API runs as DB_USER (app_user: no UPDATE/DELETE/TRUNCATE on AuditLog);
# migrations run as DB_OWNER_USER (app_owner). A full DATABASE_URL / MIGRATION_DATABASE_URL, if set,
# takes precedence (CI, Docker).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peoplehub
DB_USER=app_user
DB_PASSWORD=CHANGE_ME
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=CHANGE_ME
# Integration tests: name a separate test database on the same server (never the main one),
# or leave unset to start a Testcontainers Postgres (needs Docker).
# TEST_DB_NAME=peoplehub_test

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info
# Session and CSRF cookies are Secure by default; set false only for local http
COOKIE_SECURE=true

# AES-256-GCM keys: JSON map of key id -> base64 32 bytes
ENCRYPTION_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTES"}
ENCRYPTION_ACTIVE_KEY=k1

# SMTP (nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PeopleHub <noreply@example.com>"

# File storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=peoplehub
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Upload virus scanning: none | clamav (clamd over TCP)
VIRUS_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Optional write-once bucket (S3 Object Lock) for daily audit anchors
AUDIT_ANCHOR_BUCKET=

# OIDC (sign-in profile "OAuth")
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_AUTO_PROVISION=false
OIDC_SCOPES="openid profile email"

# Set true to run pg-boss workers and cron jobs in this process
JOBS_ENABLED=true
