# Runtime connection (app_user: no UPDATE/DELETE/TRUNCATE on AuditLog)
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/peoplehub?schema=public
# Migrations and seed run as the schema owner
MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@localhost:5432/peoplehub?schema=public
# Integration tests (leave empty to start a Testcontainers Postgres)
TEST_DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/peoplehub_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://app_owner:CHANGE_ME@localhost:5432/peoplehub_test?schema=public

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
LOG_LEVEL=info

# AES-256-GCM keys: JSON map of key id -> base64 32 bytes
ENCRYPTION_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTES"}
ENCRYPTION_ACTIVE_KEY=k1

# SMTP (nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PeopleHub <noreply@example.com>"

# File storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=peoplehub
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Optional write-once bucket (S3 Object Lock) for daily audit anchors
AUDIT_ANCHOR_BUCKET=

# OIDC (sign-in profile "OAuth")
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_AUTO_PROVISION=false

# Set true to run pg-boss workers and cron jobs in this process
JOBS_ENABLED=true
