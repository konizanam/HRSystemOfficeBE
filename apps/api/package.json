{
  "name": "@peoplehub/api",
  "version": "1.0.0",
  "private": true,
  "description": "PeopleHub ESS REST API (NestJS + Fastify + Prisma)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/as-owner.mjs prisma migrate dev",
    "db:deploy": "node scripts/as-owner.mjs prisma migrate deploy",
    "db:reset": "node scripts/as-owner.mjs prisma migrate reset --force --skip-seed",
    "db:seed": "tsx prisma/seed.ts",
    "audit:verify": "tsx src/cli/audit-verify.ts",
    "keys:rotate": "tsx src/cli/keys-rotate.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@peoplehub/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "decimal.js": "10.6.0",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "fastify": "5.11.3",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "7.0.13",
    "openid-client": "6.8.8",
    "otplib": "12.0.1",
    "pdfmake": "0.2.23",
    "pg-boss": "10.4.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "9.9.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pdfmake": "0.2.13",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
