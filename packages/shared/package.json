{
  "name": "@peoplehub/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Zod schemas, enums, DTO types and domain helpers shared by the PeopleHub API and web app",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "decimal.js": "10.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
